{
  "name": "vp-actions",
  "version": "1.2.0",
  "private": true,
  "description": "Shared GitHub Actions and Reusable Workflows for Vite+ applications",
  "type": "module",
  "scripts": {
    "agent:lint:ci": "actionlint",
    "agent:test:unit": "vp test run --reporter=tap-flat --no-color",
    "agent:verify:gate": "vpr agent:verify:unit && vpx ./scripts/release.ts --dry-run --bump=auto",
    "agent:verify:inner": "vp check && vpr typecheck && vpr agent:lint:ci",
    "agent:verify:unit": "vpr agent:verify:inner && vpr agent:test:unit",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "verkit": "0.5.0",
    "vite-plus": "catalog:",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": "26.13.1"
  }
}
